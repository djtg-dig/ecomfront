# Public browser configuration only. Never prefix server secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Keep indexing disabled locally and in preproduction. Set true only after the
# public HTTPS URL and the production SEO review have been validated.
SEO_ALLOW_INDEXING=false

# Server-only BFF configuration.
DJANGO_BACKEND_URL=http://localhost:8000
ECOMMERCE_HMAC_CLIENT_ID=ecommerce-web
ECOMMERCE_HMAC_SECRET=

# 32-byte AES-256 key, hex encoded. Generate locally with:
# openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
